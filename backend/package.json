{
  "name": "@nyaysetu/backend",
  "version": "2.0.0",
  "private": true,
  "description": "NyaySetu API: evidence, summons and bail, bridged to Ethereum",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copyAssets.mjs",
    "vercel-build": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap": "tsx src/scripts/bootstrapAdmin.ts",
    "auth:check": "tsx src/scripts/authCheck.ts",
    "flow:check": "tsx src/scripts/flowCheck.ts",
    "sweep": "tsx src/scripts/sweep.ts",
    "chain:check": "tsx src/scripts/chainCheck.ts",
    "check": "tsx src/scripts/connectionCheck.ts",
    "mail:probe": "tsx src/scripts/mailProbe.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:validate": "node scripts/validateMigrations.mjs",
    "metrics": "tsx test/metrics/run.ts",
    "samples:pdf": "tsx test/samples/pdfs.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
