{
  "name": "@nyaysetu/frontend",
  "version": "2.0.0",
  "private": true,
  "description": "NyaySetu web portals for all seven roles",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/checkCssAnimations.mjs && node scripts/checkContrast.mjs && node scripts/checkRoutes.mjs && node scripts/checkBundleSecrets.mjs",
    "check:secrets": "node scripts/checkBundleSecrets.mjs",
    "check:routes": "node scripts/checkRoutes.mjs && node scripts/checkBundleSecrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:css": "node scripts/checkCssAnimations.mjs",
    "check:contrast": "node scripts/checkContrast.mjs",
    "ui:flow": "node scripts/uiFlow.mjs",
    "ui:smoke": "node scripts/uiSmoke.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "motion": "^14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.1"
  }
}
